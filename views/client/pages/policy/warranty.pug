extends ../../layouts/default.pug

block main
  .container.my-3
    .policy-wrapper
      h2.text-center.mb-4 CHÍNH SÁCH HỖ TRỢ LỖI CHO NGƯỜI DÙNG
      .policy-intro.bg-light.p-3.mb-4.border
        p Chúng tôi hiểu rằng trong quá trình sử dụng có thể xảy ra những sự cố ngoài ý muốn như rơi vỡ, vào nước, va đập, cong vênh, trầy xước... Vì vậy, S-Mobile có chính sách hỗ trợ để giảm thiểu chi phí cho khách hàng như sau:

      .policy-content.border.p-4
        .policy-item.mb-4
          h5 1. PHẠM VI ÁP DỤNG:
          ul
            li Các sự cố do người dùng gây ra (Rơi vỡ, vào nước, va đập, cong vênh, vết móp, vết nứt, vân vết, v.v.)
        
        .policy-item.mb-4
          h5 2. HÌNH THỨC HỖ TRỢ:
          ul
            li Trong quá trình sử dụng nếu máy bị hỏng do lỗi người dùng S-Mobile hỗ trợ sửa chữa với <strong>MỨC GIÁ RẺ NHẤT</strong> trên thị trường.
            li Mức giá cụ thể sẽ được <strong>BÁO TRƯỚC VÀ MINH BẠCH</strong> cho khách hàng trước khi tiến hành sửa chữa.

        .policy-item.mb-4
          h5 3. QUY TRÌNH XỬ LÝ:
          ul
            li Khách hàng đem máy đến bất kỳ chi nhánh S-Mobile hoặc liên hệ Hotline để được kiểm tra.
            li Kỹ thuật viên sẽ báo rõ hỏng gì, chi phí dự kiến, thời gian hoàn thành trước khi sửa chữa.

        .policy-item
          h5 4. CAM KẾT:
          ul
            li S-Mobile luôn đảm bảo <strong>Giá sửa chữa hợp lý, Minh bạch và Rẻ nhất</strong> để khách hàng yên tâm khi lựa chọn dịch vụ hậu mãi của chúng tôi.

      .policy-footer.text-center.mt-4.p-3
        h4 HOTLINE: 0123.456.789
        p Cảm ơn quý khách đã luôn tin tưởng và lựa chọn S-Mobile!