extends ../../layouts/default.pug

block main
  h1(class="mb-4") Quản lý liên hệ
  
  .card.mb-3
    .card-header Danh sách liên hệ
    .card-body
      table.table.table-hover
        thead
          tr
            th STT
            th Họ tên
            th Email
            th Số điện thoại
            th Trạng thái
            th Hành động
        tbody
          each item, index in contacts
            tr
              td #{index + 1}
              td #{item.fullName}
              td #{item.email}
              td #{item.phone}
              td
                if(item.status == "unread")
                  span(class="badge badge-warning") Chưa đọc
                else
                  span(class="badge badge-success") Đã đọc
              td
                a(href=`${prefixAdmin}/contacts/detail/${item.id}` class="btn btn-info btn-sm") Chi tiết
                button(class="btn btn-danger btn-sm ml-1" button-delete data-id=item.id) Xóa