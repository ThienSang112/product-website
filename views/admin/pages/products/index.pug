extends ../../layouts/default.pug

block main
  h1(class="mb-4") Quản lý sản phẩm

  .card.mb-3
    .card-header 
      .row.align-items-center
        .col-6
          span Danh sách sản phẩm
        .col-6
          //- Thêm Form tìm kiếm nằm góc bên phải
          form(action=`${prefixAdmin}/products` method="GET" class="form-inline justify-content-end")
            .form-group.mr-2
              input(
                type="text"
                name="keyword"
                class="form-control form-control-sm"
                placeholder="Nhập tên sản phẩm..."
                value=keyword
              )
            button(type="submit" class="btn btn-primary btn-sm mr-2") Tìm kiếm
            a(href=`${prefixAdmin}/products/create` class="btn btn-success btn-sm") Thêm sản phẩm
    .card-body
      table.table.table-hover.table-sm
        thead
          tr
            th STT
            th Hình ảnh
            th Tiêu đề
            th Giá
            th Trạng thái
            th Hành động
        tbody
          if products && products.length > 0
            each item, index in products
              tr
                td #{index + 1}
                td
                  img(src=item.thumbnail, alt=item.title, width="80px", height="auto" style="border-radius: 5px;")
                td #{item.title}
                td #{item.price.toLocaleString('vi-VN')} đ
                td
                  if(item.status == "active")
                    span(class="badge badge-success") Hoạt động
                  else
                    span(class="badge badge-danger") Dừng hoạt động
                td
                  a(
                    href=`${prefixAdmin}/products/edit/${item._id}` 
                    class="btn btn-warning btn-sm mr-1"
                  ) Sửa
                  
                  button(
                    class="btn btn-danger btn-sm btn-delete-product"
                    data-id=item._id
                  ) Xóa
          else
            tr
              td(colspan="6" class="text-center") Không tìm thấy sản phẩm nào.