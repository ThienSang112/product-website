extends ../../layouts/default.pug

block main
  h1(class="mb-4") Sửa thông tin sản phẩm

  //- Form sẽ gửi dữ liệu lên đường dẫn /edit/:id với phương thức POST
  form(
    action=`${prefixAdmin}/products/edit/${product._id}`
    method="POST"
  )
    .form-group.mb-3
      label(for="title" class="font-weight-bold") Tên sản phẩm
      input(
        type="text"
        class="form-control"
        id="title"
        name="title"
        required
        value=product.title
      )

    .form-group.mb-3
      label(for="price" class="font-weight-bold") Giá (VNĐ)
      input(
        type="number"
        class="form-control"
        id="price"
        name="price"
        value=product.price
        min="0"
      )

    .form-group.mb-3
      label(for="thumbnail" class="font-weight-bold") Link Ảnh
      input(
        type="text"
        class="form-control"
        id="thumbnail"
        name="thumbnail"
        value=product.thumbnail
      )
      //- Hiển thị sẵn ảnh cũ cho dễ nhìn
      img(src=product.thumbnail, alt=product.title, width="120px" class="mt-2" style="border-radius: 5px; border: 1px solid #ddd;")
    
    .form-group.mb-4
      label(class="font-weight-bold mr-3") Trạng thái:
      .form-check.form-check-inline
        input(
          class="form-check-input"
          type="radio"
          name="status"
          id="statusActive"
          value="active"
          checked=(product.status == "active" ? true : false)
        )
        label(class="form-check-label" for="statusActive") Hoạt động
      .form-check.form-check-inline
        input(
          class="form-check-input"
          type="radio"
          name="status"
          id="statusInActive"
          value="inactive"
          checked=(product.status == "inactive" ? true : false)
        )
        label(class="form-check-label" for="statusInActive") Dừng hoạt động
    
    .form-group
      button(
        type="submit"
        class="btn btn-primary"
      ) Cập nhật sản phẩm