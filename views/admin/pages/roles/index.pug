extends ../../layouts/default.pug

block main
  h1(class="mb-4") Danh sách nhóm quyền

  .card.mb-3
    .card-header Danh sách
    .card-body
      .row
        .col-8
        .col-4.text-right
          a(
            href=`${prefixAdmin}/roles/create`
            class="btn btn-outline-success"
          ) + Thêm mới

      table.table.table-hover.mt-3
        thead
          tr
            th STT
            th Nhóm quyền
            th Hành động
        tbody
          each item, index in records
            tr
              td #{index + 1}
              td #{item.title}
              td
                a(href=`${prefixAdmin}/roles/edit/${item._id}` class="btn btn-warning btn-sm") Sửa
                button(
                    class="btn btn-danger btn-sm ml-1"
                    button-delete-role
                    data-id=item._id
                ) Xóa