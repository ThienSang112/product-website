extends ../../layouts/default.pug

block main
  h1(class="mb-4") Quản lý tài khoản Admin

  .card.mb-3
    .card-header 
      span Danh sách tài khoản
      a(
        href=`${prefixAdmin}/accounts/create`
        class="btn btn-outline-success btn-sm float-right"
      ) + Thêm mới

    .card-body
      table.table.table-hover.table-sm
        thead
          tr
            th STT
            th Họ tên
            th Email
            th Phân quyền
            th Trạng thái
            th Hành động
        tbody
          each item, index in records
            tr
              td #{index + 1}
              td #{item.fullName}
              td #{item.email}
              td 
                // Sử dụng roleTitle mà chúng ta đã gán ở Controller
                span(class="badge badge-info") #{item.roleTitle}
              td
                if(item.status == "active")
                  span(class="badge badge-success") Hoạt động
                else
                  span(class="badge badge-danger") Dừng hoạt động
              td
                a(href=`${prefixAdmin}/accounts/edit/${item._id}` class="btn btn-warning btn-sm mr-1") Sửa
                button(
                  class="btn btn-danger btn-sm"
                  button-delete
                  data-id=item._id
                ) Xóa