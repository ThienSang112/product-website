extends ../../layouts/default.pug

block main
  h1(class="mb-4") Chỉnh sửa tài khoản khách hàng

  //- Form sẽ gửi dữ liệu lên đường dẫn /edit/:id với phương thức POST
  form(
    action=`${prefixAdmin}/users/edit/${user._id}`
    method="POST"
  )
    .form-group.mb-3
      label(for="fullName" class="font-weight-bold") Họ và tên *
      input(
        type="text"
        class="form-control"
        id="fullName"
        name="fullName"
        required
        value=user.fullName
      )

    .form-group.mb-3
      label(for="email" class="font-weight-bold") Email *
      input(
        type="email"
        class="form-control"
        id="email"
        name="email"
        required
        value=user.email
      )

    .form-group.mb-3
      label(for="password" class="font-weight-bold") Mật khẩu mới
      input(
        type="password"
        class="form-control"
        id="password"
        name="password"
        placeholder="Chỉ nhập nếu muốn đổi mật khẩu mới. Nếu không, hãy để trống."
      )

    .form-group.mb-4
      label(class="font-weight-bold mr-3") Trạng thái:
      .form-check.form-check-inline
        input(
          class="form-check-input"
          type="radio"
          name="status"
          id="statusActive"
          value="active"
          checked=(user.status == "active" ? true : false)
        )
        label(class="form-check-label" for="statusActive") Hoạt động
      .form-check.form-check-inline
        input(
          class="form-check-input"
          type="radio"
          name="status"
          id="statusInActive"
          value="inactive"
          checked=(user.status == "inactive" ? true : false)
        )
        label(class="form-check-label" for="statusInActive") Bị khóa

    .form-group
      button(
        type="submit"
        class="btn btn-primary"
      ) Cập nhật thông tin