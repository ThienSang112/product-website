doctype html
html
  head
    title #{pageTitle}
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css")
    //- Thêm CSS của Toastr để thông báo đẹp hơn
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css")
    link(rel="stylesheet", href="/css/admin.css")

  body
    //- Thanh Header trên cùng
    header.header
      .container-fluid
        .row.align-items-center
          .col-3
            .inner-logo
              a(href=`${prefixAdmin}/dashboard` style="color: white; font-weight: bold; text-decoration: none;") ADMIN S-MOBILE
          .col-9.text-right
            a.btn.btn-danger.btn-sm(href=`${prefixAdmin}/auth/logout`) Đăng xuất

    .body
      //- Menu bên trái
      .sider
        .inner-menu
          ul
            li
              a(href=`${prefixAdmin}/dashboard`) Tổng quan
            li
              a(href=`${prefixAdmin}/products`) Quản lý sản phẩm
            li
              a(href=`${prefixAdmin}/accounts`) Quản lý tài khoản Admin
            li
              a(href=`${prefixAdmin}/users`) Quản lý tài khoản khách hàng
            li
              a(href=`${prefixAdmin}/contacts`) Quản lý liên hệ
            li
              a(href=`${prefixAdmin}/roles`) Phân quyền
            li
              a(href=`${prefixAdmin}/revenue`) Thống kê doanh thu
            

      //- Nội dung chính bên phải
      .main
        block main

    //- Thêm các thư viện JS cần thiết
    script(src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.min.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js")
    //- Thêm Socket.io client và Toastr JS
    script(src="/socket.io/socket.io.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js")
    script(src="/js/admin.js")
    
    //- Đoạn code xử lý thông báo thời gian thực
    script.
      const socket = io();
      socket.on("SERVER_NEW_ORDER", (data) => {
        toastr.success(data.message);
        //- Có thể thêm âm thanh báo hiệu nếu muốn
        //- new Audio('/sounds/notification.mp3').play();
      });

    //- Chart.js cũ của bạn
    script(src="https://cdn.jsdelivr.net/npm/chart.js")
    script.
      const ctx = document.getElementById('myChart');
      if(ctx) {
        new Chart(ctx, {
          type: 'line',
          data: {
            labels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
            datasets: [{
              label: 'Traffic',
              data: [12, 19, 3, 5, 2, 3, 10],
              borderColor: '#007bff',
              fill: true,
              tension: 0.4
            }]
          }
        });
      }